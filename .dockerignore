# Docker build context ignore rules
# Exclude local environment, scratch, debug, and cache files

# Environment files
.env
.env.*
*.env
!.env.example

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Python
__pycache__
*.pyc
*.pyo
*.egg-info
.eggs
dist
build
*.egg

# Virtual environments
venv
.venv
env

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs and debug
*.log
*.debug
.scratch
tmp
temp

# Git
.git
.gitignore

# CI/CD
.github
.gitlab-ci.yml

# Docs
*.md
LICENSE
CONTRIBUTING.md
SECURITY.md

# Tests (not needed in production image)
tests
pytest.ini
.pytest_cache
.coverage
htmlcov
